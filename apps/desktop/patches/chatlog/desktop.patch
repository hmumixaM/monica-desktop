+package chatlog
+
+import (
+	"context"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"github.com/rs/zerolog"
+	"github.com/rs/zerolog/log"
+	"github.com/sjzar/chatlog/internal/chatlog"
+	"github.com/spf13/cobra"
+)
+
+func newServeCommand() *cobra.Command {
+	var configDir string
+	cmd := &cobra.Command{Use: "serve", Short: "Run the loopback data API and snapshots for Monica Desktop", Args: cobra.NoArgs,
+		PersistentPreRun: func(cmd *cobra.Command, args []string) {
+			zerolog.SetGlobalLevel(zerolog.InfoLevel)
+			log.Logger = log.Output(zerolog.ConsoleWriter{Out: os.Stderr, TimeFormat: time.RFC3339, NoColor: true})
+		},
+		RunE: func(cmd *cobra.Command, args []string) error {
+			ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+			defer stop()
+			return chatlog.DesktopServe(ctx, configDir)
+		},
+	}
+	cmd.Flags().StringVar(&configDir, "config-dir", "", "Private directory containing chatlog-server.json")
+	cmd.MarkFlagRequired("config-dir")
+	return cmd
+}
+func init() { rootCmd.AddCommand(newServeCommand()) }
