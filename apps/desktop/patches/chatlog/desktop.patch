@@ -0,0 +1,158 @@
+package chatlog
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/sjzar/chatlog/internal/wechatdb/wcdbapi"
+)
+
+func TestDesktopExposesOnlyReadDataAPI(t *testing.T) {
+	handler := desktopAPIHandler(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) { w.WriteHeader(204) }))
+	for _, test := range []struct {
+		method, path string
+		status       int
+	}{
+		{"GET", "/api/v1/contacts", 204}, {"GET", "/image/example", 204},
+		{"POST", "/api/v1/contacts", 405}, {"GET", "/api/v1/hook/config", 404},
+		{"GET", "/api/v1/semantic/config", 404},
+	} {
+		result := httptest.NewRecorder()
+		handler.ServeHTTP(result, httptest.NewRequest(test.method, test.path, nil))
+		if result.Code != test.status {
+			t.Errorf("%s %s: %d", test.method, test.path, result.Code)
+		}
+	}
+}
+
+func TestDesktopConfigRejectsRemoteAndOverlappingWork(t *testing.T) {
+	root := t.TempDir()
+	source := filepath.Join(root, "source")
+	os.MkdirAll(filepath.Join(source, "db_storage"), 0700)
+	cfg := map[string]any{"data_dir": source, "work_dir": filepath.Join(root, "work"), "data_key": strings.Repeat("1", 64), "http_addr": "0.0.0.0:5030"}
+	write := func() {
+		raw, _ := json.Marshal(cfg)
+		if err := os.WriteFile(filepath.Join(root, "chatlog-server.json"), raw, 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write()
+	if _, err := loadDesktopConfig(root); err == nil {
+		t.Fatal("public bind accepted")
+	}
+	cfg["http_addr"] = "127.0.0.1:5030"
+	cfg["work_dir"] = filepath.Join(source, "output")
+	write()
+	if _, err := loadDesktopConfig(root); err == nil {
+		t.Fatal("source write accepted")
+	}
+	link := filepath.Join(root, "symlink")
+	os.Symlink(source, link)
+	cfg["work_dir"] = filepath.Join(link, "output")
+	write()
+	if _, err := loadDesktopConfig(root); err == nil {
+		t.Fatal("symlink into source accepted")
+	}
+	cfg["work_dir"] = filepath.Join(root, "work")
+	write()
+	result, err := loadDesktopConfig(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !result.DesktopMode || result.SaveDecryptedMedia || result.GetSemanticConfig().Enabled {
+		t.Fatal("desktop side effects enabled")
+	}
+}
+
+func TestDesktopSnapshotsRecoverWALUpdatesAndStop(t *testing.T) {
+	root := t.TempDir()
+	source := filepath.Join(root, "source", "db_storage")
+	dir := filepath.Join(source, "contact")
+	os.MkdirAll(dir, 0700)
+	path := filepath.Join(dir, "contact.db")
+	db, err := sql.Open("sqlite3", path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	if _, err = db.Exec("PRAGMA journal_mode=WAL; PRAGMA wal_autocheckpoint=0; CREATE TABLE contact(id INTEGER); INSERT INTO contact VALUES (1)"); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("CHATLOG_WCDB_CACHE_DIR", filepath.Join(root, "cache"))
+	client, err := wcdbapi.NewClient(source, strings.Repeat("1", 64))
+	if err != nil {
+		t.Fatal(err)
+	}
+	work := filepath.Join(root, "work")
+	snapshots := newDesktopSnapshots(client, work)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan struct{})
+	go func() { defer close(done); snapshots.run(ctx, true, 100*time.Millisecond) }()
+	out := filepath.Join(work, "db_storage", "contact", "contact.db")
+	count := func() int {
+		d, err := sql.Open("sqlite3", "file:"+out+"?mode=ro")
+		if err != nil {
+			return -1
+		}
+		defer d.Close()
+		var n int
+		if err := d.QueryRow("SELECT count(*) FROM contact").Scan(&n); err != nil {
+			return -1
+		}
+		return n
+	}
+	wait := func(expected int) {
+		deadline := time.Now().Add(8 * time.Second)
