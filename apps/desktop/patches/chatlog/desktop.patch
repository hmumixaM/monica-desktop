+func TestDesktopAcceptsExistingMasterAndRawKeys(t *testing.T) {
+	master := bytes.Repeat([]byte{7}, 32)
+	salt := bytes.Repeat([]byte{3}, 16)
+	key := pbkdf2.Key(master, salt, 256000, 32, sha512.New)
+	page := make([]byte, pageSize)
+	copy(page, salt)
+	macSalt := make([]byte, 16)
+	for i := range macSalt {
+		macSalt[i] = salt[i] ^ 0x3a
+	}
+	macKey := pbkdf2.Key(key, macSalt, 2, 32, sha512.New)
+	mac := hmac.New(sha512.New, macKey)
+	mac.Write(page[16:4032])
+	mac.Write([]byte{1, 0, 0, 0})
+	copy(page[4032:], mac.Sum(nil))
+	source := filepath.Join(t.TempDir(), "db")
+	os.WriteFile(source, page, 0600)
+	c := &Client{}
+	for _, configured := range [][]byte{master, key} {
+		got, err := c.encryptionKey(source, hex.EncodeToString(configured))
+		if err != nil || got != hex.EncodeToString(key) {
+			t.Fatal("valid key format not recognized", err)
+		}
+	}
+	if _, err := c.encryptionKey(source, strings.Repeat("1", 64)); err == nil {
+		t.Fatal("incorrect key accepted")
+	}
+}
