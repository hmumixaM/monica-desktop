@@ -0,0 +1,368 @@
+package chatlog
+
+import (
+	"context"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net"
+	stdhttp "net/http"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+
+	"github.com/fsnotify/fsnotify"
+	"github.com/mitchellh/mapstructure"
+	"github.com/rs/zerolog/log"
+	"github.com/sjzar/chatlog/internal/chatlog/conf"
+	"github.com/sjzar/chatlog/internal/chatlog/database"
+	chathttp "github.com/sjzar/chatlog/internal/chatlog/http"
+	"github.com/sjzar/chatlog/internal/wechatdb/wcdbapi"
+	"github.com/sjzar/chatlog/pkg/filemonitor"
+	"github.com/sjzar/chatlog/pkg/util/dat2img"
+)
+
+// DesktopServe runs only the local data API and an atomic snapshot exporter.
+// It never initializes TUI state, key extraction, hooks or the separate AI engine.
+func DesktopServe(ctx context.Context, configDir string) error {
+	cfg, err := loadDesktopConfig(configDir)
+	if err != nil {
+		return err
+	}
+	lock, err := os.OpenFile(filepath.Join(configDir, ".serve.lock"), os.O_CREATE|os.O_RDWR, 0o600)
+	if err != nil {
+		return err
+	}
+	defer lock.Close()
+	if err := syscall.Flock(int(lock.Fd()), syscall.LOCK_EX|syscall.LOCK_NB); err != nil {
+		return fmt.Errorf("desktop Chatlog is already running for this configuration")
+	}
+	defer syscall.Flock(int(lock.Fd()), syscall.LOCK_UN)
+	if os.Getenv("CHATLOG_WCDB_CACHE_DIR") == "" {
+		os.Setenv("CHATLOG_WCDB_CACHE_DIR", filepath.Join(cfg.WorkDir, "wcdb-cache"))
+	}
+	cache, err := canonicalDestination(os.Getenv("CHATLOG_WCDB_CACHE_DIR"))
+	if err != nil || !filepath.IsAbs(cache) || pathsOverlap(cfg.DataDir, cache) {
+		return fmt.Errorf("CHATLOG_WCDB_CACHE_DIR must be absolute and separate from the WeChat source")
+	}
+	client, err := wcdbapi.NewClient(cfg.DataDir, cfg.DataKey)
+	if err != nil {
+		return err
+	}
+	// The upstream database service logs some contact-loader errors and returns
+	// an empty list, so validate the actual table before declaring readiness.
+	if _, err := client.Query("contact", "", "SELECT username FROM contact LIMIT 1"); err != nil {
+		return fmt.Errorf("WeChat contact database is not readable: %w", err)
+	}
+	snapshots := newDesktopSnapshots(client, cfg.WorkDir)
+	db := database.NewService(cfg)
+	if err := db.Start(); err != nil {
+		return fmt.Errorf("open WeChat source: %w", err)
+	}
+	defer db.Stop()
+	// Opening the database object alone doesn't validate its encryption key.
+	if _, err := db.GetContacts("", 1, 0); err != nil {
+		return fmt.Errorf("WeChat contact database is not readable: %w", err)
+	}
+	if _, err := db.GetSessions("", 1, 0); err != nil {
+		return fmt.Errorf("WeChat session database is not readable: %w", err)
+	}
+	dat2img.SetAesKey(cfg.ImgKey)
+	service := chathttp.NewService(cfg, db)
+	defer service.Stop()
+	listener, err := net.Listen("tcp", cfg.HTTPAddr)
+	if err != nil {
+		return err
+	}
+	defer listener.Close()
+	mux := stdhttp.NewServeMux()
+	mux.HandleFunc("/api/v1/ready", func(w stdhttp.ResponseWriter, r *stdhttp.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(map[string]any{"ready": true, "mode": "desktop"})
+	})
+	mux.HandleFunc("/api/v1/desktop/status", func(w stdhttp.ResponseWriter, r *stdhttp.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(snapshots.status())
+	})
+	mux.Handle("/", desktopAPIHandler(service.Handler()))
+	server := &stdhttp.Server{Handler: mux, ReadHeaderTimeout: 10 * time.Second}
+	serverDone := make(chan error, 1)
+	go func() { serverDone <- server.Serve(listener) }()
+	defer func() {
+		shutdown, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		server.Shutdown(shutdown)
+	}()
+	watchCtx, cancelWatch := context.WithCancel(ctx)
+	defer cancelWatch()
+	watchDone := make(chan struct{})
+	go func() {
+		defer close(watchDone)
+		snapshots.run(watchCtx, cfg.AutoDecrypt, time.Duration(cfg.AutoDecryptDebounce)*time.Millisecond)
+	}()
+	defer func() { cancelWatch(); <-watchDone }()
+	log.Info().Str("address", listener.Addr().String()).Msg("desktop Chatlog API ready")
+	select {
+	case <-ctx.Done():
+		return nil
+	case err := <-serverDone:
+		if errors.Is(err, stdhttp.ErrServerClosed) {
+			return nil
+		}
+		return err
+	}
+}
+
+// Desktop consumers need the data API, not the upstream administration routes.
+func desktopAPIHandler(next stdhttp.Handler) stdhttp.Handler {
+	allowed := map[string]bool{}
+	for _, route := range []string{"/health", "/api/v1/ping", "/api/v1/sessions", "/api/v1/history", "/api/v1/search", "/api/v1/unread", "/api/v1/members", "/api/v1/new_messages", "/api/v1/stats", "/api/v1/favorites", "/api/v1/sns_notifications", "/api/v1/sns_feed", "/api/v1/sns_search", "/api/v1/sns/media/proxy", "/api/v1/contacts", "/api/v1/chatrooms", "/api/v1/db", "/api/v1/db/search", "/api/v1/db/tables", "/api/v1/db/data", "/api/v1/db/query"} {
+		allowed[route] = true
+	}
+	return stdhttp.HandlerFunc(func(w stdhttp.ResponseWriter, r *stdhttp.Request) {
+		if r.Method != stdhttp.MethodGet && r.Method != stdhttp.MethodHead {
+			w.WriteHeader(stdhttp.StatusMethodNotAllowed)
+			return
+		}
+		ok := allowed[r.URL.Path]
+		for _, prefix := range []string{"/image/", "/video/", "/file/", "/voice/", "/data/"} {
+			ok = ok || strings.HasPrefix(r.URL.Path, prefix)
+		}
+		if !ok {
+			stdhttp.NotFound(w, r)
+			return
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+func loadDesktopConfig(configDir string) (*conf.ServerConfig, error) {
+	if !filepath.IsAbs(configDir) {
+		return nil, fmt.Errorf("config-dir must be an absolute path")
+	}
+	raw, err := os.ReadFile(filepath.Join(configDir, "chatlog-server.json"))
+	if err != nil {
+		return nil, err
+	}
+	var values map[string]any
+	if err = json.Unmarshal(raw, &values); err != nil {
+		return nil, fmt.Errorf("invalid desktop Chatlog configuration")
+	}
+	cfg := &conf.ServerConfig{Platform: "darwin", Version: 4, HTTPAddr: "127.0.0.1:5030", AutoDecrypt: true, WalEnabled: true, AutoDecryptDebounce: 1000}
+	if err = mapstructure.Decode(values, cfg); err != nil {
+		return nil, fmt.Errorf("invalid desktop Chatlog field types")
+	}
+	if cfg.Platform != "darwin" || cfg.Version != 4 {
+		return nil, fmt.Errorf("desktop mode requires platform darwin and WeChat version 4")
+	}
+	host, port, err := net.SplitHostPort(cfg.HTTPAddr)
+	if err != nil || port == "" {
+		return nil, fmt.Errorf("http_addr must be a loopback address with a port")
+	}
+	ip := net.ParseIP(host)
+	if ip == nil || !ip.IsLoopback() {
+		return nil, fmt.Errorf("desktop Chatlog must bind a numeric loopback address")
+	}
+	if !filepath.IsAbs(cfg.DataDir) || !filepath.IsAbs(cfg.WorkDir) {
+		return nil, fmt.Errorf("data_dir and work_dir must be absolute")
+	}
+	source, err := filepath.EvalSymlinks(cfg.DataDir)
+	if err != nil {
+		return nil, fmt.Errorf("WeChat data directory is unavailable")
+	}
+	cfg.DataDir = source
+	// Resolve the destination before creating it, including any existing symlinked parent.
+	work, err := canonicalDestination(cfg.WorkDir)
+	if err != nil {
+		return nil, err
+	}
+	cfg.WorkDir = work
+	if pathsOverlap(cfg.DataDir, cfg.WorkDir) {
+		return nil, fmt.Errorf("work_dir must be separate from the WeChat source directory")
+	}
+	key, err := hex.DecodeString(cfg.DataKey)
+	if err != nil || len(key) != 32 {
+		return nil, fmt.Errorf("a valid existing 64-character data_key is required")
+	}
+	cfg.DesktopMode = true
+	cfg.SaveDecryptedMedia = false
+	cfg.Semantic = nil
+	cfg.MessageHook = nil
+	if cfg.AutoDecryptDebounce < 100 {
+		cfg.AutoDecryptDebounce = 1000
+	}
+	if err = os.MkdirAll(cfg.WorkDir, 0o700); err != nil {
+		return nil, err
+	}
+	return cfg, nil
+}
+
+func canonicalDestination(path string) (string, error) {
+	path = filepath.Clean(path)
+	if resolved, err := filepath.EvalSymlinks(path); err == nil {
+		return resolved, nil
+	}
+	parent := filepath.Dir(path)
+	if parent == path {
+		return "", fmt.Errorf("invalid work directory")
+	}
+	resolved, err := canonicalDestination(parent)
+	if err != nil {
+		return "", err
+	}
+	return filepath.Join(resolved, filepath.Base(path)), nil
+}
+func pathsOverlap(a, b string) bool {
+	inside := func(root, path string) bool {
+		rel, err := filepath.Rel(root, path)
+		return err == nil && (rel == "." || !strings.HasPrefix(rel, ".."+string(filepath.Separator)) && rel != "..")
+	}
+	return inside(a, b) || inside(b, a)
+}
+
+type desktopSnapshotStatus struct {
+	Ready    bool   `json:"snapshots_ready"`
+	Files    int    `json:"snapshot_files"`
+	Updated  int    `json:"updated_last_pass"`
+	Failures int    `json:"failed_files"`
+	LastPass string `json:"last_pass_at,omitempty"`
+	Watcher  string `json:"watcher"`
+}
+type desktopSnapshots struct {
+	client *wcdbapi.Client
+	work   string
+	mu     sync.RWMutex
+	state  desktopSnapshotStatus
+	stamps map[string]string
+}
+
+func newDesktopSnapshots(c *wcdbapi.Client, work string) *desktopSnapshots {
+	return &desktopSnapshots{client: c, work: work, stamps: map[string]string{}, state: desktopSnapshotStatus{Watcher: "starting"}}
+}
+func (s *desktopSnapshots) status() desktopSnapshotStatus {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	return s.state
+}
+func snapshotStamp(path string) string {
+	parts := []string{}
+	for _, suffix := range []string{"", "-wal"} {
+		if st, err := os.Stat(path + suffix); err == nil {
+			parts = append(parts, fmt.Sprintf("%d:%d", st.Size(), st.ModTime().UnixNano()))
+		} else {
+			parts = append(parts, "missing")
+		}
+	}
+	return strings.Join(parts, ":")
+}
+func (s *desktopSnapshots) refresh(ctx context.Context) {
+	var files []string
+	for _, pattern := range []string{"contact/contact.db", "session/session.db", "sns/sns.db", "message/message_[0-9]*.db"} {
+		matches, _ := filepath.Glob(filepath.Join(s.client.DataDir(), pattern))
+		files = append(files, matches...)
+	}
+	sort.Strings(files)
+	updated, failures := 0, 0
+	for _, source := range files {
+		if ctx.Err() != nil {
+			return
+		}
+		info, err := os.Stat(source)
+		if err != nil || info.Size() == 0 {
+			continue
+		}
+		stamp := snapshotStamp(source)
+		rel, _ := filepath.Rel(s.client.DataDir(), source)
+		out := filepath.Join(s.work, "db_storage", rel)
+		if s.stamps[source] == stamp {
+			if _, err := os.Stat(out); err == nil {
+				continue
+			}
+		}
+		if err := s.client.ExportDatabase(ctx, source, out); err != nil {
+			if ctx.Err() != nil {
+				return
+			}
+			failures++
+			log.Warn().Str("database", rel).Msg("desktop snapshot failed; retained previous snapshot")
+			continue
+		}
+		// A changed source is retried; don't acknowledge bytes that arrived mid-copy.
+		if snapshotStamp(source) == stamp {
+			s.stamps[source] = stamp
+		}
+		updated++
+	}
+	s.mu.Lock()
+	s.state.Ready = failures == 0 && len(files) > 0
+	s.state.Files = len(s.stamps)
+	s.state.Updated = updated
+	s.state.Failures = failures
+	s.state.LastPass = time.Now().UTC().Format(time.RFC3339)
+	s.mu.Unlock()
+	log.Info().Int("files", len(s.stamps)).Int("updated", updated).Int("failed", failures).Msg("desktop snapshot pass")
+}
+func (s *desktopSnapshots) run(ctx context.Context, auto bool, debounce time.Duration) {
+	changes := make(chan struct{}, 1)
+	var monitor *filemonitor.FileMonitor
+	if auto {
+		monitor = filemonitor.NewFileMonitor()
+		group, err := filemonitor.NewFileGroup("desktop", s.client.DataDir(), `.*\.db(-wal|-shm)?$`, []string{"fts"})
+		if err == nil {
+			group.AddCallback(func(fsnotify.Event) error {
+				select {
+				case changes <- struct{}{}:
+				default:
+				}
+				return nil
+			})
+			err = monitor.AddGroup(group)
+		}
+		if err == nil {
+			err = monitor.Start()
+		}
+		s.mu.Lock()
+		if err == nil {
+			s.state.Watcher = "active"
+		} else {
+			s.state.Watcher = "polling"
+		}
+		s.mu.Unlock()
+		if err == nil {
+			defer monitor.Stop()
+		}
+	} else {
+		s.mu.Lock()
+		s.state.Watcher = "disabled"
+		s.mu.Unlock()
+	}
+	s.refresh(ctx)
+	if !auto {
+		return
+	}
+	// Periodic reconciliation also catches events lost while macOS was asleep.
+	ticker := time.NewTicker(30 * time.Second)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			s.refresh(ctx)
+		case <-changes:
+			timer := time.NewTimer(debounce)
+			select {
+			case <-ctx.Done():
+				timer.Stop()
+				return
+			case <-timer.C:
+			}
+			s.refresh(ctx)
+		}
+	}
+}
