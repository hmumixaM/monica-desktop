+func TestDesktopWALIgnoresUncommittedAndDamagedTail(t *testing.T) {
+	for _, big := range []bool{false, true} {
+		t.Run(map[bool]string{false: "little", true: "big"}[big], func(t *testing.T) {
+			key := bytes.Repeat([]byte{4}, 32)
+			var order binary.ByteOrder = binary.LittleEndian
+			header := make([]byte, 32)
+			magic := uint32(0x377f0682)
+			if big {
+				order = binary.BigEndian
+				magic++
+			}
+			binary.BigEndian.PutUint32(header, magic)
+			binary.BigEndian.PutUint32(header[4:], 3007000)
+			binary.BigEndian.PutUint32(header[8:], 4096)
+			binary.BigEndian.PutUint32(header[16:], 17)
+			binary.BigEndian.PutUint32(header[20:], 19)
+			s1, s2 := walChecksum(header[:24], 0, 0, order)
+			binary.BigEndian.PutUint32(header[24:], s1)
+			binary.BigEndian.PutUint32(header[28:], s2)
+			wal := header
+			for i, value := range []byte{'a', 'b', 'c'} {
+				frame := make([]byte, 24+4096)
+				binary.BigEndian.PutUint32(frame, 2)
+				if i == 0 {
+					binary.BigEndian.PutUint32(frame[4:], 2)
+				}
+				copy(frame[8:16], header[16:24])
+				plain := bytes.Repeat([]byte{value}, 4016)
+				block, _ := aes.NewCipher(key)
+				cipher.NewCBCEncrypter(block, make([]byte, 16)).CryptBlocks(frame[24:24+4016], plain)
+				s1, s2 = walChecksum(frame[:8], s1, s2, order)
+				s1, s2 = walChecksum(frame[24:], s1, s2, order)
+				binary.BigEndian.PutUint32(frame[16:], s1)
+				binary.BigEndian.PutUint32(frame[20:], s2)
+				if i == 2 {
+					frame[60] ^= 1
+				}
+				wal = append(wal, frame...)
+			}
+			root := t.TempDir()
+			src := filepath.Join(root, "db-wal")
+			dst := filepath.Join(root, "db")
+			os.WriteFile(src, append(wal, 1, 2, 3), 0600)
+			os.WriteFile(dst, make([]byte, 3*4096), 0600)
+			if err := applyWAL(src, dst, key); err != nil {
+				t.Fatal(err)
+			}
+			got, _ := os.ReadFile(dst)
+			if len(got) != 8192 || !bytes.Equal(got[4096:4096+4016], bytes.Repeat([]byte{'a'}, 4016)) {
+				t.Fatal("uncommitted/damaged frame entered snapshot")
+			}
+		})
+	}
+}
