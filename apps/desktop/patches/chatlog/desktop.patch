+// ExportDatabase installs a consistent, standalone SQLite snapshot, including WAL.
+// The source and its sidecars are only opened read-only. The destination must be
+// outside the source tree; consumers see only the previous or complete new file.
+func (c *Client) ExportDatabase(ctx context.Context, src, destination string) error {
+	source, err := filepath.Abs(src)
+	if err != nil {
+		return err
+	}
+	target, err := filepath.Abs(destination)
+	if err != nil {
+		return err
+	}
+	if rel, err := filepath.Rel(c.dataDir, target); err != nil || rel == "." || !strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		return fmt.Errorf("snapshot destination must be outside source data")
+	}
+	plain, err := c.ensureDecryptedContext(ctx, source)
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(filepath.Dir(target), 0o700); err != nil {
+		return err
+	}
+	file, err := os.CreateTemp(filepath.Dir(target), ".snapshot-*.db")
+	if err != nil {
+		return err
+	}
+	temp := file.Name()
+	file.Close()
+	defer os.Remove(temp)
+	inURL := url.URL{Scheme: "file", Path: plain}
+	q := url.Values{"mode": {"ro"}, "_query_only": {"1"}}
+	inURL.RawQuery = q.Encode()
+	inDB, err := sql.Open("sqlite3", inURL.String())
+	if err != nil {
+		return err
+	}
+	defer inDB.Close()
+	outDB, err := sql.Open("sqlite3", temp)
+	if err != nil {
+		return err
+	}
+	defer outDB.Close()
+	inConn, err := inDB.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer inConn.Close()
+	outConn, err := outDB.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	err = outConn.Raw(func(dst any) error {
+		return inConn.Raw(func(src any) error {
+			backup, err := dst.(*sqlite3.SQLiteConn).Backup("main", src.(*sqlite3.SQLiteConn), "main")
+			if err != nil {
+				return err
+			}
+			defer backup.Close()
+			for {
+				if err := ctx.Err(); err != nil {
+					return err
+				}
+				done, err := backup.Step(256)
+				if err != nil {
+					return err
+				}
+				if done {
+					return nil
+				}
+				select {
+				case <-ctx.Done():
+					return ctx.Err()
+				case <-time.After(time.Millisecond):
+				}
+			}
+		})
+	})
+	outConn.Close()
+	if err != nil {
+		return err
+	}
+	// SQLite backup copies the source WAL header. Convert it before publication
+	// so read-only consumers need neither -wal/-shm files nor write access.
+	var journalMode string
+	if err := outDB.QueryRowContext(ctx, "PRAGMA journal_mode=DELETE").Scan(&journalMode); err != nil {
+		return err
+	}
+	if journalMode != "delete" {
+		return fmt.Errorf("snapshot did not leave WAL mode")
+	}
+	var result string
+	if err := outDB.QueryRowContext(ctx, "PRAGMA quick_check").Scan(&result); err != nil {
+		return err
+	}
+	if result != "ok" {
+		return fmt.Errorf("snapshot integrity check failed")
+	}
+	if err := outDB.Close(); err != nil {
+		return err
+	}
+	f, err := os.OpenFile(temp, os.O_RDWR, 0o600)
+	if err != nil {
+		return err
+	}
+	err = f.Sync()
+	f.Close()
+	if err != nil {
+		return err
+	}
+	return os.Rename(temp, target)
+}
