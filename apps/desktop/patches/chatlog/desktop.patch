+func parseContactLabelIDs(data []byte) ([]int64, error) {
+	ids := make([]int64, 0)
+	for len(data) > 0 {
+		number, wireType, tagLength := protowire.ConsumeTag(data)
+		if tagLength < 0 {
+			return nil, protowire.ParseError(tagLength)
+		}
+		data = data[tagLength:]
+
+		if number == 30 && wireType == protowire.BytesType {
+			value, valueLength := protowire.ConsumeBytes(data)
+			if valueLength < 0 {
+				return nil, protowire.ParseError(valueLength)
+			}
+			for _, rawID := range strings.Split(string(value), ",") {
+				rawID = strings.TrimSpace(rawID)
+				if rawID == "" {
+					continue
+				}
+				id, err := strconv.ParseInt(rawID, 10, 64)
+				if err != nil {
+					return nil, fmt.Errorf("invalid contact label id %q: %w", rawID, err)
+				}
+				ids = append(ids, id)
+			}
+			data = data[valueLength:]
+			continue
+		}
+
+		valueLength := protowire.ConsumeFieldValue(number, wireType, data)
+		if valueLength < 0 {
+			return nil, protowire.ParseError(valueLength)
+		}
+		data = data[valueLength:]
+	}
+	return ids, nil
+}
+
+func resolveContactLabels(ids []int64, labelNames map[int64]string) []string {
+	labels := make([]string, 0, len(ids))
+	for _, id := range ids {
+		if label := strings.TrimSpace(labelNames[id]); label != "" {
+			labels = append(labels, label)
+		}
+	}
+	return labels
+}
