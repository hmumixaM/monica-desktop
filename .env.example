APP_ENV=development
DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5432/crm
RAW_ROOT=./runtime/raw
MEDIA_ROOT=./runtime/media
SESSION_SECRET=replace-with-a-long-random-secret
IMPORT_HMAC_SECRET=replace-with-a-long-random-secret
# Optional source-specific overrides: wechat=...,instagram=...,linkedin=...,monica=...,faces=...
IMPORT_HMAC_SECRETS=
LINKEDIN_COLLECTION_TOKEN=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Model features through the NAS LiteLLM proxy; nothing is sent to a model while this is false.
AI_ENABLED=false
LITELLM_BASE_URL=http://host.docker.internal:4000/v1
LITELLM_API_KEY=
