<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>wiki.drw.monica-faces</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__INSTALL__/launchd/watch.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- When the NAS is unreachable the scan exits; wait before trying again. -->
  <key>ThrottleInterval</key>
  <integer>300</integer>
  <!-- Background throttles CPU and network so hard that detection runs about sixty times slower. -->
  <key>ProcessType</key>
  <string>Standard</string>
  <key>StandardOutPath</key>
  <string>__HOME__/.cache/monica-faces/watch.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.cache/monica-faces/watch.log</string>
</dict>
</plist>
